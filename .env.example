# Copia este archivo a "assets/env" y rellena los valores.
# (Se usa assets/env, sin punto inicial: un archivo .env NO se empaqueta en el
#  build web release de Flutter y la app queda en pantalla blanca.)
# SOLO valores PUBLICOS. NUNCA pongas aqui el service_role key.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=tu-anon-key-publica

# (OPCIONAL) Override del id del rol "Cliente" (roles.id) que gatea el acceso.
# Por defecto esta fijo en codigo (AuthController._defaultClientRoleId = 23,
# el id de produccion). Solo setealo aqui si compilas contra otro ambiente.
CLIENTE_ROL_ID=

# --- Backend contra DEV -------------------------------------------------------
# Copia este archivo tambien a "assets/env.dev" con los valores del ambiente de
# desarrollo y corre:
#
#   BACKEND=dev ./tool/dev.sh
#
# La app habla entonces con las edge functions de DEV, que se publican solas al
# entrar algo a la rama `dev`. Sin esto, probar un cambio de backend obliga a
# pasarlo por PR, `dev`, `main` y deploy a produccion.
#
# `assets/env` NUNCA se modifica para esto: los valores viajan por --dart-define,
# asi que no hay forma de quedarse apuntando a DEV por olvido.
