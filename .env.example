# Copia este archivo a "assets/env" y rellena los valores.
# (Se usa assets/env, sin punto inicial: un archivo .env NO se empaqueta en el
#  build web release de Flutter y la app queda en pantalla blanca.)
# SOLO valores PUBLICOS. NUNCA pongas aqui el service_role key.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=tu-anon-key-publica

# Id del rol de usuario final "Cliente" (roles.id). Gatea el acceso a la app
# por rol_id en vez del nombre del rol. Distinto por ambiente (dev/prod).
# Obtenlo con: SELECT id FROM roles WHERE nombre = 'Cliente';
# Si se deja vacío, el acceso cae al chequeo por nombre "Cliente" (transición).
CLIENTE_ROL_ID=
